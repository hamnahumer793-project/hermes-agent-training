
{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "CP1 French Letter A Lesson",
    "description": "Schema for validating an educational lesson scene.",
    "type": "object",
    "required": [
        "grade",
        "language",
        "learning_objective",
        "duration_seconds",
        "scenes",
        "narration",
        "visual_prompt",
        "quality_checks"
    ],
    "properties": {
        "grade": {
            "type": "string",
            "minLength": 1
        },
        "language": {
            "type": "string",
            "minLength": 1
        },
        "learning_objective": {
            "type": "string",
            "minLength": 1
        },
        "duration_seconds": {
            "type": "integer",
            "minimum": 1
        },
        "scenes": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "scene_number",
                    "title"
                ],
                "properties": {
                    "scene_number": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "title": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        },
        "narration": {
            "type": "string",
            "minLength": 1
        },
        "visual_prompt": {
            "type": "string",
            "minLength": 1
        },
        "quality_checks": {
            "type": "object",
            "additionalProperties": {
                "type": "boolean"
            }
        }
    },
    "additionalProperties": false
}
